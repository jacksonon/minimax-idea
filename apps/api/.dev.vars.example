# DreamReel API — Local Dev Secrets (template)
# Copy to .dev.vars and fill in real values.
# NEVER commit .dev.vars. See AGENTS.md §9.
#
# In production, set these via:
#   wrangler secret put <NAME>
# See: https://developers.cloudflare.com/workers/configuration/secrets/

# GMI Cloud API key (https://console.gmicloud.ai)
# IMPORTANT: do NOT set this. The service is a host only — every
# user must bring their own GMI API key (entered at /me?tab=key and
# stored encrypted in D1). If you fill this in for local dev, the
# production handler ignores it anyway; just leave it blank.
GMI_API_KEY=

# GMI Cloud base URL (do not change unless instructed)
GMI_BASE_URL=https://api.gmicloud.ai

# AES-256-GCM key for at-rest encryption of user API keys (the
# `user_settings` table). Any non-empty string; SHA-256'd to 32 bytes
# internally. In production, use `openssl rand -base64 32` and put it
# via `wrangler secret put GMI_ENC_KEY`.
GMI_ENC_KEY=dev-only-please-rotate

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: ${ALLOWED_ORIGIN}/api/auth/github/callback
# In production: wrangler secret put GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Environment: development | production
ENVIRONMENT=development

# Allowed CORS origin (the deployed web app URL)
ALLOWED_ORIGIN=http://localhost:3000

# Optional: a webhook URL for important events (generation failures, etc.)
# If empty, no webhook is sent.
DISCORD_WEBHOOK_URL=
