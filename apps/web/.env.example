# DreamReel Web — Environment Variables (template)
# Copy to .env.local and fill in real values.
# NEVER commit .env.local. See AGENTS.md §9.

# Public site URL (used for OAuth callbacks and absolute URLs)
NEXTAUTH_URL=http://localhost:3000

# Random 32+ byte secret used to sign NextAuth JWTs
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-real-secret

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: ${NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=

# Internal Worker URL (used by Next.js route handlers when calling the API).
# In production, this is your deployed Worker URL.
# In dev, run `pnpm --filter api dev` which listens on 8787.
API_INTERNAL_URL=http://localhost:8787

# Public API URL (used by client components to call the API directly).
# Must be the same host as the Worker in production.
NEXT_PUBLIC_API_URL=http://localhost:8787
